integrator      = md
dt              = 0.001
nsteps          = 10
nstlog          = 1
nstcalcenergy   = 1
cutoff-scheme   = Verlet
nstlist         = 10
verlet-buffer-tolerance = -1
rlist           = 1.0
coulombtype     = cut-off
rcoulomb        = 1.0
vdwtype         = cut-off
vdw-modifier    = none
rvdw            = 1.0
DispCorr        = no
pbc             = xyz
gen-vel         = yes
gen-temp        = 100
gen-seed        = 12345
